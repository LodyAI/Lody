+Napi::Value GetFeedUrl(const Napi::CallbackInfo &info) {
+  Napi::Env env = info.Env();
+  __block NSString *feedUrl = nil;
+  void (^work)(void) = ^{
+    if (g_updater != nil && g_updater.feedURL != nil) {
+      feedUrl = g_updater.feedURL.absoluteString;
+    } else {
+      NSString *plistFeedUrl = [NSBundle mainBundle].infoDictionary[@"SUFeedURL"];
+      if ([plistFeedUrl isKindOfClass:[NSString class]] && plistFeedUrl.length > 0) {
+        feedUrl = plistFeedUrl;
+      }
+    }
+  };
+  if ([NSThread isMainThread]) {
+    work();
+  } else {
+    dispatch_sync(dispatch_get_main_queue(), work);
+  }
+  if (feedUrl == nil) return env.Null();
+  return Napi::String::New(env, feedUrl.UTF8String);
+}
