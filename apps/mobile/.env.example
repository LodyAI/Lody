# Copy to .env.local in this directory. No secrets belong here.
# Missing or empty values use production. Use client-facing TLS origins for local-stack.
CONVEX_URL=https://convex.lody.ai
CONVEX_SITE_URL=https://backend.lody.ai
CF_WORKER_URL=https://api.lody.ai
# Streams WebSocket (reads, RPC replies, presence, appends): 1 or true enables it; otherwise HTTP.
LODY_LORO_STREAMS_WS_ENABLED=
