{
  "name": "@lody-ios/ios",
  "version": "0.111.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "open Lody.xcodeproj",
    "ios": "pnpm prebuild && open Lody.xcodeproj",
    "prebuild": "pnpm native:assets && python3 scripts/prebuild-native.py",
    "bundle": "pnpm native:assets",
    "typecheck": "tsc --noEmit && pnpm --filter @lody/cloud-runtime typecheck",
    "native:assets": "node scripts/build-decoder.mjs",
    "licenses:build": "node scripts/build-licenses.mjs",
    "licenses:check": "node scripts/build-licenses.mjs --check"
  },
  "dependencies": {
    "@lody/cloud-runtime": "workspace:*",
    "@loro-dev/flock-wasm": "0.4.3",
    "@loro-dev/streams-client": "0.7.0",
    "@loro-dev/streams-crdt": "0.16.1",
    "@pierre/diffs": "1.4.1",
    "@rien7/anchored-overlay-kit": "0.3.0",
    "base64-js": "1.5.1",
    "diff": "9.0.0",
    "fzstd": "0.1.1",
    "loro-crdt": "1.15.1",
    "punycode": "2.3.1",
    "remend": "1.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "werift": "0.24.4",
    "ws": "8.21.3"
  }
}
