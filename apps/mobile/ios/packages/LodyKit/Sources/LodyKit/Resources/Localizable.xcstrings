    "schedules.blocked.PERMISSION_UNAVAILABLE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a permission mode supported by the Agent, then save again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择 Agent 当前支持的权限模式，然后重新保存。"
          }
        }
      }
    },
    "schedules.blocked.CAPACITY_EXHAUSTED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent quota is used up. The next run waits until the quota resets; later runs during the outage are skipped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent 额度已用完。下一次运行会等到额度恢复；期间的其余运行会被跳过。"
          }
        }
      }
    },
    "schedules.blocked.E2EE_SCHEDULE_NOT_AUTHORIZED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This schedule’s changes are not authorized. Its owner must review and save it again before it can run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份计划的改动尚未获得授权。需要由计划所有者检查并重新保存，才能执行。"
          }
        }
      }
    },
    "schedules.blocked.OWNER_OR_AGENT_UNAVAILABLE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check machine ownership and the Agent configuration, then save again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查机器所有权和 Agent 配置，然后重新保存。"
          }
        }
      }
    },
    "schedules.blocked.PROJECT_UNAVAILABLE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an available Project and save again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目已不可用，请重新选择项目并保存。"
          }
        }
      }
    },
    "schedules.blocked.DEFINITION_NOT_COMMITTED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the schedule configuration to finish syncing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待任务配置同步完成。"
          }
        }
      }
    },
    "schedules.blocked.DEFINITION_UNAVAILABLE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The configuration is unavailable. Check the machine connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取任务配置，请检查机器网络连接。"
          }
        }
      }
    },
    "schedules.blocked.DISPATCH_UNAVAILABLE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Session could not be submitted. Check the Agent on the target machine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话暂时无法提交，请检查目标机器上的 Agent。"
          }
        }
      }
    },
    "schedules.blocked.SCHEDULES_DISABLED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled execution on this machine is paused by its environment configuration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此机器的定时执行已由运行环境暂停。"
          }
        }
      }
    },
    "schedules.blocked.SESSION_BUSY": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for this chat to finish its current work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待此对话完成当前任务。"
          }
        }
      }
    },
    "schedules.blocked.LEGACY_QUOTA_UNASSOCIATED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This old quota continuation could not be linked to its original work and was not sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条旧额度继续无法关联到原工作，已停止发送。"
          }
        }
      }
    },
    "schedules.blocked.QUOTA_RECOVERY_ALREADY_ACCEPTED": {
      "extractionState": "manual",
