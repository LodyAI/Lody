        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This continuation was not sent because the original work was already resumed or could not be identified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原工作已恢复或无法确认，这条继续消息未发送。"
