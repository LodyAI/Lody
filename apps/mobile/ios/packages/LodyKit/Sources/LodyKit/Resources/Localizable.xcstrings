    "session.delete.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除会话？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Session?"
          }
        }
      }
    },
    "session.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除「%1$@」并将其从会话列表中移除？删除后将无法在 Lody 中查看这段对话，且无法在应用内撤销。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%1$@” and remove it from your session list? Its conversation will no longer be available in Lody. This cannot be undone in the app."
          }
        }
      },
      "comment": "1: title"
    },
    "session.delete.withTabs": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除「%2$@」及其 %1$@ 个子标签页？删除后将无法在 Lody 中查看这些对话，且无法在应用内撤销。另行开启的独立会话会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%2$@” and its %1$@ child tabs? Their conversations will no longer be available in Lody. Separately opened sessions are kept. This cannot be undone in the app."
          }
        }
      },
      "comment": "1: count; 2: title"
    },
    "session.delete.busy": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先停止此会话及正在运行的子标签页，再进行删除。"
