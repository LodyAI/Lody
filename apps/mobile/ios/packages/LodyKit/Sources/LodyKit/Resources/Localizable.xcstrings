    "native.chat.editAction": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑并重新发送"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit and resend"
          }
        }
      }
    },
    "chat.edit.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑消息"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit message"
          }
        }
      }
    },
    "chat.edit.notice": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新发送将替换这条消息及其回复，并停止当前回复。已经产生的文件改动会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resending replaces this message and its replies. Any current reply will stop. Changes already made to files are kept."
          }
        }
      }
    },
    "chat.edit.loadFailed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法编辑这条消息，请检查连接后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to open this message for editing. Check your connection and try again."
          }
        }
      }
    },
    "chat.edit.failed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能替换消息，编辑内容已保留。请检查连接，并确认它仍是最后一条可编辑消息。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message could not be replaced. Your edits are kept. Check the connection and whether this is still the last editable message."
          }
        }
      }
    },
    "chat.edit.unknown": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未确认重新发送的结果。编辑内容已保留，请先检查状态，避免重复发送。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resend has not been confirmed. Your edits are kept; check its status before sending again."
          }
        }
      }
    },
