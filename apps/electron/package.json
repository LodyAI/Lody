{
  "name": "@lody/electron",
  "productName": "Lody",
  "desktopName": "dev.loro.lody.oss.desktop",
  "private": true,
  "version": "0.76.0",
  "description": "Lody Desktop - Electron app",
  "main": "./out/main/index.js",
  "author": "LodyAI",
  "homepage": "https://github.com/LodyAI/Lody",
  "scripts": {
    "format": "prettier --write .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/system-language-argument.test.mjs src/main/reload-shortcut.test.mjs src/main/close-focused-tab-or-window.test.mjs src/main/onboarding-launch-policy.test.mjs src/main/auto-launch-policy.test.mjs src/main/window-theme.test.mjs src/main/local-platform-snapshot.test.mjs src/main/ipc/ipc-channel-list.test.mjs src/main/services/local-path-launcher-core.test.mjs src/main/services/image-export-core.test.mjs src/main/services/public-browser-state.test.mjs src/main/services/app-updater-linux-install.test.mjs src/main/services/app-updater-metadata.test.mjs src/main/services/app-updater-sparkle-policy.test.mjs src/main/services/app-updater-sparkle-events.test.mjs src/main/services/loro-data-plane-relay.test.mjs src/renderer/renderer-csp.test.mjs src/renderer/src/auth-callback-transaction.test.mjs src/renderer/src/auth-query-generation.test.mjs src/renderer/src/renderer-error-reporting.test.mjs scripts/sparkle-packaging.test.mjs",
    "lint": "eslint --cache .",
    "typecheck:node": "tsgo --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsgo --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start:local": "node scripts/start-local.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "preview:local": "electron-vite preview --skipBuild --mode oss",
    "build:cli": "node scripts/build-cli.mjs",
    "build:app": "pnpm run typecheck && node scripts/build-app.mjs",
    "build": "pnpm run build:cli && pnpm run sync:cli && pnpm run build:app",
    "postinstall": "node scripts/postinstall.mjs",
    "sync:cli": "node scripts/sync-cli-dist.mjs",
    "sync:cli:dev": "node scripts/sync-cli-dev-dist.mjs",
    "package": "node scripts/package-electron.mjs",
    "verify:sparkle-update": "node scripts/verify-sparkle-update.mjs",
    "build:unpack": "pnpm run build && node scripts/package-electron.mjs --dir",
    "build:win": "pnpm run build && node scripts/package-electron.mjs --win",
    "build:mac": "pnpm run build && node scripts/package-electron.mjs --mac",
    "build:linux": "pnpm run build && node scripts/package-electron.mjs --linux"
  },
  "dependencies": {
    "@better-auth/electron": "catalog:",
    "@convex-dev/better-auth": "catalog:",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lody/cli-supervisor": "workspace:*",
    "@lody/platform": "workspace:*",
    "@lody/shared": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "better-auth": "catalog:",
    "conf": "^15.1.0",
    "convex": "catalog:",
    "effect": "catalog:",
    "electron-ipc-decorator": "^1.0.2",
    "electron-sparkle-updater": "0.3.0",
    "electron-updater": "^6.3.9",
    "jotai": "catalog:",
    "posthog-node": "^5.38.8",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@lody/components": "workspace:*",
    "@lody/configs": "workspace:*",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "postcss": "^8.5.4",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vite-plugin-wasm": "^3.5.0"
  }
}
