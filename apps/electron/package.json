{
  "name": "@lody/electron",
  "productName": "Lody",
  "desktopName": "dev.loro.lody.oss.desktop",
  "private": true,
  "version": "0.113.1",
  "description": "Lody Desktop - Electron app",
  "main": "./out/main/index.js",
  "author": "LodyAI",
  "homepage": "https://github.com/LodyAI/Lody",
  "scripts": {
    "format": "oxfmt",
    "test": "node scripts/run-tests.mjs && pnpm run test:release",
    "typecheck:node": "tsgo --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsgo --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "node scripts/run-typecheck.mjs",
    "start:local": "node scripts/start-local.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "preview:local": "electron-vite preview --skipBuild --mode oss",
    "build:cli": "node scripts/build-cli.mjs",
    "build:app": "pnpm run typecheck && node scripts/build-app.mjs",
    "build": "pnpm run build:cli && pnpm run sync:cli && pnpm run build:app",
    "postinstall": "node scripts/postinstall.mjs",
    "sync:cli": "node scripts/sync-cli-dist.mjs",
    "sync:cli:dev": "node scripts/sync-cli-dev-dist.mjs",
    "package": "node scripts/package-electron.mjs",
    "verify:sparkle-update": "node scripts/verify-sparkle-update.mjs",
    "build:unpack": "pnpm run build && node scripts/package-electron.mjs --dir",
    "build:win": "pnpm run build && node scripts/package-electron.mjs --win",
    "build:mac": "pnpm run build && node scripts/package-electron.mjs --mac",
    "build:linux": "pnpm run build && node scripts/package-electron.mjs --linux",
    "format:check": "oxfmt --check",
    "build:app:test": "node scripts/build-test-app.mjs",
    "test:release": "node --test *.test.mjs",
    "build:win:release": "node scripts/cloud-release.mjs production --win",
    "build:linux:release": "node scripts/cloud-release.mjs production --linux",
    "build:linux:arm64:release": "node scripts/cloud-release.mjs production --linux AppImage deb --arm64",
    "build:mac:release": "node scripts/cloud-release.mjs production --mac --arm64 --x64",
    "build:mac:staging": "node scripts/cloud-release.mjs staging --mac",
    "build:linux:arm64": "pnpm run build && node scripts/package-electron.mjs --linux AppImage deb --arm64",
    "package:nightly:mac": "node package-electron.mjs --production --mac --arm64 --x64 --publish never",
    "package:nightly:win": "node package-electron.mjs --production --win --x64 --publish never",
    "package:nightly:linux": "node package-electron.mjs --production --linux snap --x64 --publish never && node package-electron.mjs --production --linux AppImage deb --x64 --publish never",
    "package:nightly:linux-arm64": "node package-electron.mjs --production --linux AppImage deb --arm64 --publish never"
  },
  "dependencies": {
    "@better-auth/electron": "catalog:",
    "@convex-dev/better-auth": "catalog:",
    "@devframes/agentic": "catalog:",
    "@devframes/hub": "catalog:",
    "@devframes/hub-ui": "catalog:",
    "@devframes/json-render": "catalog:",
    "@devframes/json-render-ui": "catalog:",
    "@devframes/plugin-a11y": "catalog:",
    "@devframes/plugin-a11y--assets": "catalog:",
    "@devframes/plugin-inspect": "catalog:",
    "@devframes/plugin-inspect--assets": "catalog:",
    "@devframes/plugin-terminals": "catalog:",
    "@devframes/plugin-terminals--assets": "catalog:",
    "@electron-toolkit/utils": "^4.0.0",
    "@lody/cli-supervisor": "workspace:*",
    "@lody/platform": "workspace:*",
    "@lody/shared": "workspace:*",
    "better-auth": "catalog:",
    "better-sqlite3": "catalog:",
    "conf": "^15.1.0",
    "convex": "catalog:",
    "devframe": "catalog:",
    "effect": "catalog:",
    "electron-ipc-decorator": "^1.0.2",
    "electron-sparkle-updater": "0.5.1",
    "electron-updater": "^6.3.9",
    "image-dimensions": "^2.5.1",
    "posthog-node": "^5.38.8",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:",
    "@lody/cloud-api": "workspace:*",
    "@lody/loro-streams-rpc": "workspace:*"
  },
  "devDependencies": {
    "@lody/e2ee-core": "workspace:*",
    "@lody/iroh-native": "workspace:*",
    "@noble/ciphers": "2.1.1",
    "@stylexjs/unplugin": "0.19.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@lody/components": "workspace:*",
    "@lody/ui": "workspace:*",
    "@lody/configs": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.5",
    "postcss": "^8.5.4",
    "oxfmt": "^0.65.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vite-plugin-wasm": "^3.6.0",
    "tsx": "4.23.7",
    "@lody/e2ee-machine-sharing": "workspace:*",
    "@lody/e2ee-client": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "jotai": "catalog:",
    "semver": "^7.7.4",
    "yaml": "2.8.2",
    "fast-xml-parser": "5.11.1"
  }
}
