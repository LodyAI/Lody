{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@lody/plugin-sdk": ["../../../packages/plugin-sdk/src/index.ts"],
      "@lody/plugin-sdk/client": ["../../../packages/plugin-sdk/src/client.ts"],
      "@lody/plugin-sdk/manifest": ["../../../packages/plugin-sdk/src/manifest.ts"],
