{
  "id": "sorbet-workflow",
  "version": "0.1.0",
  "sdk": "^1.0.0",
  "title": "Sorbet Super Assistant",
  "description": "End-to-end workflow plugin bundling Agent Roles, Skills, MCP memory, custom ACP runtime, event-driven verification, and cross-provider tool/block renderers.",
  "client": "./client.tsx",
  "machine": "./machine.ts",
  "skills": ["sorbet-planner", "sorbet-verifier"],
  "agentRoles": [
    {
      "id": "sorbet-architect",
      "name": "Sorbet Architect",
      "emoji": "🍨",
      "promptPath": "./roles/sorbet-architect.md",
      "skills": ["sorbet-planner", "sorbet-verifier"],
      "mcpServers": ["sorbet-memory"],
      "defaultProvider": "plugin:sorbet-workflow:sorbet-acp"
    }
  ],
  "mcpServers": [
    {
      "id": "sorbet-memory",
      "title": "Sorbet Graph Memory",
      "transport": "stdio",
      "entry": "./dist/sorbet-mcp.js",
      "envKeys": ["SORBET_API_KEY"]
    }
  ],
  "acpProviders": [
    {
      "id": "sorbet-acp",
      "title": "Sorbet Harness",
      "entry": "./dist/sorbet-acp.js",
      "envKeys": ["SORBET_API_KEY"],
      "capabilities": {
        "loadSession": true,
        "subagentEvents": true,
        "configOptions": true
      }
    }
  ],
  "config": {
    "autoVerify": {
      "type": "boolean",
      "scope": "both",
      "label": "Auto-spawn verifier after Architect turn",
      "default": true
    },
    "SORBET_API_KEY": {
      "type": "secret",
      "scope": "machine",
      "label": "Sorbet API Key",
      "required": true
    }
  },
  "onboarding": {
    "title": "Connect Sorbet Super Assistant",
    "summary": "Enter your Sorbet API key to unlock the Sorbet Architect Role and automated verification.",
    "fields": ["SORBET_API_KEY", "autoVerify"]
  }
}
