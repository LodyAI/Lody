{
  "id": "sorbet-workflow",
  "version": "0.1.0",
  "sdk": "^1.0.0",
  "title": "Sorbet Super Assistant",
  "description": "End-to-end workflow plugin bundling Agent Roles, Skills, MCP memory, custom ACP runtime, event-driven verification, and cross-provider tool/block renderers.",
  "client": "./client.tsx",
  "machine": "./machine.ts",
  "skills": ["sorbet-planner", "sorbet-verifier"],
  "agentRoles": [
    {
      "id": "sorbet-architect",
      "name": "Sorbet Architect",
      "emoji": "🍨",
      "promptPath": "./roles/sorbet-architect.md",
      "skills": ["sorbet-planner", "sorbet-verifier"],
      "mcpServers": ["sorbet-memory"],
      "defaultProvider": "plugin:sorbet-workflow:sorbet-acp"
    },
    {
      "id": "sorbet-verifier",
      "name": "Sorbet Verifier",
      "emoji": "✅",
      "promptPath": "./roles/sorbet-verifier.md",
      "skills": ["sorbet-verifier"],
      "mcpServers": ["sorbet-memory"],
      "defaultProvider": "plugin:sorbet-workflow:sorbet-acp"
    }
  ],
  "mcpServers": [
    {
      "id": "sorbet-memory",
      "title": "Sorbet Graph Memory",
      "transport": "stdio",
      "entry": "./runtime/sorbet-mcp.mjs"
    }
  ],
  "acpProviders": [
    {
      "id": "sorbet-acp",
      "title": "Sorbet Harness",
      "managedAgent": "pi"
    }
  ],
  "config": {
    "autoVerify": {
      "type": "boolean",
      "scope": "both",
      "label": "Auto-spawn verifier after Architect turn",
      "default": true
    }
  },
  "onboarding": {
    "title": "Connect Sorbet Super Assistant",
    "summary": "Choose whether completed Architect turns start a verifier session.",
    "fields": ["autoVerify"]
  },
  "permissions": ["sessions.write", "workflow.autonomous"]
}
