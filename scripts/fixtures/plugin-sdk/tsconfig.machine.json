{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2023"],
    "typeRoots": ["../../../packages/shared/node_modules/@types"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@lody/plugin-sdk": ["./sdk/shared.d.ts"],
      "@lody/plugin-sdk/machine": ["./sdk/machine.d.ts"],
      "@lody/plugin-sdk/manifest": ["./sdk/manifest.d.ts"],
      "zod": ["../../../packages/shared/node_modules/zod"]
    }
  },
  "include": [
    "./sdk/shared.d.ts",
    "./sdk/machine.d.ts",
    "./sdk/manifest.d.ts",
    "./examples/**/shared.ts",
    "./examples/**/machine.ts",
    "./machine-contracts.ts"
  ]
}
