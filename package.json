{
  "name": "lody",
  "version": "1.0.0",
  "description": "Local-first workspace for coding agents",
  "private": true,
  "scripts": {
    "preinstall": "node scripts/guard-nested-workspace-install.mjs",
    "build": "corepack pnpm --dir apps/electron build",
    "dev:cli": "corepack pnpm --filter lody dev",
    "dev:site-docs": "corepack pnpm --filter @lody/site-docs dev",
    "dev:local": "corepack pnpm --dir apps/electron dev:local",
    "start:local": "corepack pnpm --dir apps/electron start:local",
    "storybook": "corepack pnpm --filter @lody/components storybook",
    "storybook:review-helper": "corepack pnpm --filter @lody/code-review-helper storybook",
    "build-storybook:review-helper": "corepack pnpm --filter @lody/code-review-helper build-storybook",
    "clean": "corepack pnpm -r run clean",
    "format": "corepack pnpm -r --filter '!acp-extension-claude' --filter '!acp-extension-codex' run format",
    "format:check": "corepack pnpm -r --filter '!acp-extension-claude' --filter '!acp-extension-codex' run format:check",
    "typecheck": "corepack pnpm --filter lody prepare:acp-adapters && corepack pnpm -r --workspace-concurrency=1 --filter '!acp-extension-claude' --filter '!acp-extension-codex' run typecheck",
    "test": "corepack pnpm -r --workspace-concurrency=1 run test",
    "test:scripts": "node --test scripts/*.test.mjs scripts/docs/*.test.mjs",
    "docs": "node scripts/docs/main.mjs",
    "test:ci": "corepack pnpm test:scripts && corepack pnpm -r --workspace-concurrency=2 --filter \"!@lody/electron\" --filter \"!acp-extension-codex\" --filter \"!acp-extension-claude\" run test --maxWorkers=2 && corepack pnpm --filter @lody/electron run test",
    "test:watch": "corepack pnpm -r run test:watch",
    "test:coverage": "corepack pnpm -r run test:coverage",
    "e2e:build": "corepack pnpm --dir apps/electron build",
    "e2e:check": "corepack pnpm --filter @lody/e2e check",
    "e2e:smoke": "corepack pnpm --filter @lody/e2e smoke",
    "e2e:full": "corepack pnpm --filter @lody/e2e full",
    "e2e:scout": "corepack pnpm --filter @lody/e2e scout",
    "e2e:scout:ablation": "corepack pnpm --filter @lody/e2e scout:ablation",
    "e2e:acceptance": "corepack pnpm --filter @lody/e2e acceptance",
    "e2e:journey:author": "node e2e/scripts/run-journey-author.mjs",
    "e2e:journey:candidate": "corepack pnpm --filter @lody/e2e journey:candidate",
    "e2e:journey:coverage": "corepack pnpm --filter @lody/e2e journey:coverage",
    "e2e:journey:validate": "node e2e/scripts/validate-journey-candidate.mjs",
    "lint:fast": "oxlint --quiet --ignore-pattern packages/acp-extension-kimi",
    "lint": "oxlint --type-aware --quiet --ignore-pattern packages/acp-extension-kimi",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "check:code-collab-imports": "node scripts/check-code-collab-imports.mjs",
    "check:platform-boundaries": "node scripts/check-platform-boundaries.mjs",
    "check:public-boundary": "node scripts/check-public-boundary.mjs",
    "check:quick": "corepack pnpm lint && corepack pnpm lint:i18n && corepack pnpm check:code-collab-imports && corepack pnpm check:platform-boundaries && corepack pnpm check:public-boundary",
    "check:heavy": "corepack pnpm check",
    "generate:acp-registry": "node scripts/generate-acp-registry.mjs",
    "generate:open-source-attributions": "node scripts/generate-open-source-attributions.mjs",
    "package:kimi-runtime": "node scripts/package-kimi-runtime.mjs",
    "check": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test:ci && corepack pnpm lint:i18n && corepack pnpm check:code-collab-imports && corepack pnpm check:platform-boundaries && corepack pnpm check:public-boundary",
    "install:all": "corepack pnpm install",
    "build:electron": "corepack pnpm --dir apps/electron build",
    "build:electron:mac": "corepack pnpm --dir apps/electron build:mac",
    "build:electron:win": "corepack pnpm --dir apps/electron build:win",
    "build:electron:linux": "corepack pnpm --dir apps/electron build:linux"
  },
  "keywords": [
    "cli",
    "server",
    "typescript",
    "command-line",
    "agent",
    "remote-execution"
  ],
  "author": "LodyAI",
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.0.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20251217.1",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.22.0",
    "prettier": "^3.6.2",
    "proxy-from-env": "^1.1.0",
    "tar": "^7.5.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.2",
    "undici": "catalog:",
    "zstd-stream": "^1.1.0"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
  "pnpm": {
    "packageExtensions": {
      "streamdown": {
        "dependencies": {
          "shiki": "3.22.0"
        }
      }
    }
  }
}
