{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["react", "react-dom", "node", "vite/client"],
    "paths": {
      "@site/*": ["./*"],
      "fumadocs-mdx:collections/*": ["./.source/*"],
      "collections/*": ["./.source/*"]
    }
  },
  "include": [
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "types/**/*.d.ts",
    ".source/**/*.ts",
    "source.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "app/**/*.ts", "app/**/*.tsx", "lib/**/*.test.ts"]
}
