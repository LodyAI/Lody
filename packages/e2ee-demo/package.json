{
  "name": "@lody/e2ee-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/session.ts",
    "./host": "./src/host.ts"
  },
  "scripts": {
    "start": "vite build && tsx src/cli.ts",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:browser": "LODY_E2EE_DEMO_BROWSER=1 vitest run test/d2-browser.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "format": "prettier --write src test package.json tsconfig.json README.md AGENTS.md vite.config.ts vitest.config.ts index.html",
    "format:check": "prettier --check src test package.json tsconfig.json README.md AGENTS.md vite.config.ts vitest.config.ts index.html",
    "build:ui": "vite build"
  },
  "dependencies": {
    "@lody/e2ee-core": "workspace:*",
    "@loro-dev/flock-wasm": "catalog:",
    "@loro-dev/sqlite-riverrun": "0.3.0",
    "@loro-dev/streams-client": "catalog:",
    "@loro-dev/streams-crdt": "file:./vendor/streams-crdt.tgz",
    "loro-crdt": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "playwright": "1.58.2",
    "tsx": "4.23.13",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^3.2.4"
  }
}
