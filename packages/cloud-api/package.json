{
  "name": "@lody/cloud-api",
  "version": "0.0.1",
  "description": "Public client contract for optional Lody Cloud integrations.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "format": "oxfmt 'src/**/*.ts'",
    "format:check": "oxfmt --check 'src/**/*.ts'"
  },
  "dependencies": {
    "@lody/shared": "workspace:*",
    "acp-extension-core": "workspace:*",
    "convex": "catalog:"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
