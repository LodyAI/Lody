{
  "name": "@lody/code-review-helper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "review-helper": "./bin/review-helper.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node/index.ts",
      "import": "./src/node/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts"
    },
    "./standalone": {
      "types": "./src/standalone/index.ts",
      "import": "./src/standalone/index.ts"
    },
    "./prompt-text": {
      "types": "./src/standalone/embedded-prompt.d.ts",
      "import": "./dist-standalone/embedded-prompt.ts"
    },
    "./styles.css": "./src/react/styles.css",
    "./prompt": "./prompts/review-helper-agent.md"
  },
  "scripts": {
    "review-helper": "node bin/review-helper.mjs",
    "view": "node bin/review-helper.mjs view",
    "validate": "node bin/review-helper.mjs validate",
    "build": "pnpm run build:standalone",
    "build:prompt-text": "node scripts/embed-standalone.mjs",
    "build:standalone": "vite build --config vite.standalone.config.ts && pnpm run build:prompt-text",
    "storybook": "storybook dev -p 6017",
    "build-storybook": "storybook build",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lody/components": "workspace:*",
    "@pierre/diffs": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@vitejs/plugin-react": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@shikijs/langs": "^3.0.0",
    "@storybook/react": "^9.1.17",
    "@storybook/react-vite": "^9.1.17",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "^26.1.0",
    "storybook": "^9.1.17",
    "tailwindcss": "^4.3.0",
    "typescript": "catalog:",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "5.0.0"
  },
  "license": "Apache-2.0"
}
