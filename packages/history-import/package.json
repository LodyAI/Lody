{
  "name": "@lody/history-import",
  "version": "0.0.1",
  "description": "Pure domain logic for importing local agent conversation history into Lody sessions.",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "bench": "tsx benchmarks/history-import.bench.ts",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:capture": "tsx benchmarks/capture-fixture.ts",
    "bench:open": "tsx benchmarks/open-conversation.bench.ts"
  },
  "dependencies": {
    "@lody/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "loro-crdt": "catalog:",
    "loro-mirror": "catalog:",
    "tinybench": "^2.9.0",
    "tsx": "^4.23.5",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  },
  "license": "Apache-2.0"
}
