{
  "name": "@lody/client-e2ee",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./network": "./src/network.ts",
    "./recovery": "./src/recovery.ts",
    "./recovery-workspaces": "./src/recovery-workspaces.ts",
    "./recovery-port": "./src/recovery-port.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --no-file-parallelism",
    "format": "oxfmt --threads=1 --config ../../.oxfmtrc.json 'src/**/*.ts' 'test/**/*.ts' vitest.config.ts",
    "format:check": "oxfmt --threads=1 --config ../../.oxfmtrc.json --check 'src/**/*.ts' 'test/**/*.ts' vitest.config.ts"
  },
  "dependencies": {
    "@lody/cloud-api": "workspace:*",
    "@lody/e2ee-core": "workspace:*",
    "@lody/e2ee-client": "workspace:*",
    "effect": "catalog:",
    "convex": "catalog:",
    "zod": "catalog:",
    "@lody/platform": "workspace:*",
    "@lody/shared": "workspace:*",
    "@noble/hashes": "2.2.0",
    "@lody/e2ee-machine-sharing": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "3.2.4",
    "oxfmt": "^0.65.0",
    "fake-indexeddb": "6.2.5"
  }
}
