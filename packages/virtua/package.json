{
  "name": "@lody/virtua",
  "version": "0.52.7-lody.1",
  "description": "Lody's fork of Virtua (React list virtualizer): sizes keyed by item key and the reader's item kept in place when items change.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}'",
    "format:check": "oxfmt --check 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}'"
  },
  "peerDependencies": {
    "react": ">=16.14.0",
    "react-dom": ">=16.14.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.65.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
