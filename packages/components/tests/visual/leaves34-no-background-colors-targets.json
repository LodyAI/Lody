    "migration-ownednobackgroundactioncolors--default": [
      {
        "action": "visible",
        "selector": "[data-no-bg-ready=true]"
      },
      {
        "action": "disabled",
        "selector": "[data-no-bg-case=disabled] button[data-variant=ghost]"
      },
      {
        "action": "waitForFunction",
        "expression": "() => {const r=document.querySelector('[data-no-bg-colors=default]');if(!r||r.dataset.noBgReady!=='true')return false;const enabled=document.querySelector(\"[data-no-bg-case=operation] button[data-variant=ghost]\"),disabled=document.querySelector(\"[data-no-bg-case=disabled] button[data-variant=ghost]\"),more=document.querySelector(\"[data-no-bg-case=more] button[aria-label=\\\"More actions\\\"]\");if(!enabled||!disabled||!more||enabled.disabled||!disabled.disabled||more.disabled||document.querySelectorAll(\"[data-no-bg-case=more] button[aria-label=\\\"More actions\\\"]\").length!==1)return false;for(const e of [enabled,disabled,more]){const s=getComputedStyle(e);if(s.height!=='28px')return false;}return document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||!a.pending&&a.playState!=='running');}"
      }
    ],
    "migration-ownednobackgroundactioncolors--scoped": [
      {
        "action": "visible",
        "selector": "[data-no-bg-ready=true]"
      },
      {
        "action": "disabled",
        "selector": "[data-no-bg-case=disabled] button[data-variant=ghost]"
