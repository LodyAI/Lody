            "key": "Escape"
          },
          {
            "action": "waitForFunction",
            "expression": "() => ![...document.querySelectorAll('[role=\"menu\"]')].some(e => e.getBoundingClientRect().height > 0)"
          }
        ]
      }
    ]
  }
}
