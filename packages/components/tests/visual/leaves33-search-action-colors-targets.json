  "themes": ["light", "dark"],
  "locale": "en",
  "reducedMotion": "reduce",
  "ids": ["sessions-sessionchatsearch--states", "sessions-searchmigration--many-matches"],
  "ready": {
    "sessions-sessionchatsearch--states": [
      {
        "action": "visible",
        "role": "searchbox",
        "name": "Find in session",
        "index": 0
      },
      {
        "action": "waitForFunction",
        "expression": "() => {const rows=[...document.querySelectorAll('[role=search]')];if(rows.length!==4)return false;const values=['','search','search','quantumfizzbuzz'];for(const [i,r]of rows.entries()){if(r.querySelector('input')?.value!==values[i])return false;const bs=[...r.querySelectorAll('button')];if(bs.length!==3||bs.some(b=>getComputedStyle(b).width!=='24px'||getComputedStyle(b).height!=='24px'))return false;const disabled=i===0||i===3;if(bs[0].disabled!==disabled||bs[1].disabled!==disabled||bs[2].disabled)return false;}return document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||!a.pending&&a.playState!=='running');}"
      }
    ],
    "sessions-searchmigration--many-matches": [
      {
        "action": "visible",
        "role": "searchbox",
        "name": "Find in session"
      },
      {
        "action": "waitForFunction",
        "expression": "() => {const r=document.querySelector('[role=search]');return r&&r.querySelector('input').value==='needle'&&r.querySelector('[aria-live]')?.textContent.trim()==='128 / 128'&&[...r.querySelectorAll('button')].every(b=>getComputedStyle(b).width==='24px'&&getComputedStyle(b).height==='24px');}"
      }
    ]
  },
