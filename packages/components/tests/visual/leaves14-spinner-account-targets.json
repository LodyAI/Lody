        "action": "waitForFunction",
        "expression": "() => { const marks=[...document.querySelectorAll(\"button[aria-label=\\\"Edit name\\\"] [data-slot=spinner]\")];return marks.length===1&&marks.every(mark=>{const css=getComputedStyle(mark),unit=css.getPropertyValue('--spacing').trim(),step=parseFloat(unit)*(unit.endsWith('rem')?parseFloat(getComputedStyle(document.documentElement).fontSize):1),expected=step*3.5,r=mark.getBoundingClientRect();let node=mark;while(node&&node!==document.body){if(Number(getComputedStyle(node).opacity)<=0)return false;node=node.parentElement;}return Math.abs(parseFloat(css.width)-expected)<0.01&&Math.abs(parseFloat(css.height)-expected)<0.01&&r.top>=0&&r.bottom<=innerHeight&&r.left>=0&&r.right<=innerWidth;}); }"
