  "states": {
    "mobile-ownedmobileprojectsettingsmigration--multiple-machines": [
      {
        "name": "hover",
        "steps": [
          {
            "action": "hover",
            "selector": "[data-mobile-project-settings] section:first-of-type button:last-of-type"
          }
        ]
      },
      {
        "name": "focus",
        "steps": [
          {
            "action": "movePointer",
            "x": -10,
            "y": -10
          },
          {
            "action": "focus",
            "selector": "[data-mobile-project-settings] section:first-of-type button:last-of-type"
          }
        ]
      },
      {
        "name": "open",
        "steps": [
          {
            "action": "press",
            "selector": "[data-mobile-project-settings] section:first-of-type button:last-of-type",
            "key": "Enter"
          },
          {
            "action": "visible",
            "selector": "[data-mobile-project-intent]"
          }
        ]
      }
    ]
  }
