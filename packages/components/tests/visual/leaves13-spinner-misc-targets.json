        "expression": "() => { const items=[...document.querySelectorAll('[data-slot=spinner]')].filter(e=>e.checkVisibility({checkOpacity:true,checkVisibilityCSS:true})&&e.getBoundingClientRect().width>0); return items.length>=1&&items.every(e=>{const s=getComputedStyle(e);return s.width==='14px'&&s.height==='14px'&&e.querySelector('svg')?.getAttribute('aria-label')==='Loading';}); }"
