{
  "viewports": [
    {
      "name": "desktop",
      "width": 1280,
      "height": 900
    },
    {
      "name": "phone",
      "device": "iPhone SE",
      "width": 390,
      "height": 900
    }
  ],
  "themes": ["light", "dark"],
  "reducedMotion": "reduce",
  "ids": [
    "chat-chatlandingview--submission-pending-dark",
    "chat-machinepairingdialog--creating",
    "chat-machinepairingdialog--claimed",
    "components-loadingplaceholder--default",
    "components-loadingplaceholder--with-description",
    "sessions-sessionsharedialog--sharing",
    "sessions-sessiongoalbanner--pending-pause",
    "sessions-sessionsyncingindicator--default",
    "sessions-sessionusagepopover--compacting",
    "components-sidebarupdatebanner--restarting"
  ],
  "ready": {
    "chat-chatlandingview--submission-pending-dark": [
      {
        "action": "waitForFunction",
        "expression": "() => { const items=[...document.querySelectorAll('[data-slot=spinner]')].filter(e=>e.checkVisibility({checkOpacity:true,checkVisibilityCSS:true})&&e.getBoundingClientRect().width>0); return items.length>=1&&items.every(e=>{const s=getComputedStyle(e);return s.width==='16px'&&s.height==='16px'&&e.querySelector('svg')?.getAttribute('aria-label')==='Loading';}); }"
      }
    ],
    "chat-machinepairingdialog--creating": [
      {
        "action": "waitForFunction",
        "expression": "() => { const items=[...document.querySelectorAll('[data-slot=spinner]')].filter(e=>e.checkVisibility({checkOpacity:true,checkVisibilityCSS:true})&&e.getBoundingClientRect().width>0); return items.length>=1&&items.every(e=>{const s=getComputedStyle(e);return s.width==='20px'&&s.height==='20px'&&e.querySelector('svg')?.getAttribute('aria-label')==='Loading';}); }"
      }
    ],
