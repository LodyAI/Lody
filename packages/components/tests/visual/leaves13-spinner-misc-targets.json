  },
  "states": {
    "sessions-sessionusagepopover--compacting": [
      {
        "name": "opened",
        "steps": [
          {
            "action": "click",
            "selector": "#storybook-root button"
          },
          {
            "action": "visible",
            "role": "dialog"
          },
          {
            "action": "waitForFunction",
            "expression": "() => {const items=[...document.querySelectorAll('[data-slot=spinner]')].filter(e=>e.checkVisibility({checkOpacity:true,checkVisibilityCSS:true})&&e.getBoundingClientRect().width>0);return items.length===2&&items.every(e=>getComputedStyle(e).width==='14px'&&getComputedStyle(e).height==='14px');}"
          }
        ]
      }
    ]
  },
  "allowBlankIds": [
    "chat-machinepairingdialog--creating",
    "chat-machinepairingdialog--claimed",
    "sessions-sessionsharedialog--sharing"
  ]
}
