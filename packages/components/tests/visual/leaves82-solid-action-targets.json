      },
      {
        "action": "waitForFunction",
        "expression": "()=>!!document.querySelector('[data-solid-owner-migration]')&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
      },
      {
        "action": "waitForFunction",
        "expression": "()=>{const expected=new URL(location.href).searchParams.get('globals')?.match(/(?:^|;)theme:([^;]+)/)?.[1];return ['light','dark'].includes(expected)&&document.documentElement.classList.contains('dark')===(expected==='dark');}"
      }
