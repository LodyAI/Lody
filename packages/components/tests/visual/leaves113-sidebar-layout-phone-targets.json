{
  "viewports": [
    {
      "name": "phone",
      "device": "iPhone 13",
      "width": 390,
      "height": 1000
    }
  ],
  "themes": ["light", "dark"],
  "reducedMotion": "reduce",
  "ids": [
    "migration-ownedlegacysidebarlayout--natural",
    "migration-ownedlegacysidebarlayout--scoped"
  ],
  "ready": {
    "migration-ownedlegacysidebarlayout--natural": [
      {
        "action": "waitForFunction",
        "expression": "() => document.documentElement.classList.contains('dark')===matchMedia('(prefers-color-scheme: dark)').matches"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.querySelector('[data-sidebar-layout-state]')?.dataset.sidebarLayoutMobile==='true'"
      },
      {
        "action": "click",
        "selector": "[data-sidebar-layout-toggle]"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.querySelector('[data-sidebar-layout-state]')?.dataset.sidebarLayoutOpen==='true'&&document.querySelectorAll('[data-layout-part]').length===5&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
      }
    ],
    "migration-ownedlegacysidebarlayout--scoped": [
      {
        "action": "waitForFunction",
        "expression": "() => document.documentElement.classList.contains('dark')===matchMedia('(prefers-color-scheme: dark)').matches"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.querySelector('[data-sidebar-layout-state]')?.dataset.sidebarLayoutMobile==='true'"
      },
      {
        "action": "click",
        "selector": "[data-sidebar-layout-toggle]"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.querySelector('[data-sidebar-layout-state]')?.dataset.sidebarLayoutOpen==='true'&&document.querySelectorAll('[data-layout-part]').length===5&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
      }
    ]
  },
  "states": {
    "migration-ownedlegacysidebarlayout--natural": [
      {
        "name": "keyboard-slot",
        "steps": [
          {
            "action": "focus",
            "selector": "[data-mobile=true] [data-layout-action=slot]"
          },
          {
            "action": "press",
            "selector": "[data-mobile=true] [data-layout-action=slot]",
            "key": "Enter"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-sidebar-layout-event]').textContent==='Slot'"
          }
        ]
      },
      {
        "name": "closed",
        "steps": [
          {
            "action": "press",
            "selector": "[data-mobile=true] [data-layout-action=slot]",
            "key": "Escape"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-sidebar-layout-state]')?.dataset.sidebarLayoutOpen==='false'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
          }
        ]
      },
      {
        "name": "reopened",
        "steps": [
          {
            "action": "click",
            "selector": "[data-sidebar-layout-toggle]"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-sidebar-layout-state]')?.dataset.sidebarLayoutOpen==='true'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
          }
        ]
      }
    ],
    "migration-ownedlegacysidebarlayout--scoped": [
      {
        "name": "keyboard-slot",
        "steps": [
          {
            "action": "focus",
            "selector": "[data-mobile=true] [data-layout-action=slot]"
          },
          {
            "action": "press",
            "selector": "[data-mobile=true] [data-layout-action=slot]",
            "key": "Enter"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-sidebar-layout-event]').textContent==='Slot'"
          }
        ]
      },
      {
        "name": "closed",
        "steps": [
          {
            "action": "press",
            "selector": "[data-mobile=true] [data-layout-action=slot]",
            "key": "Escape"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-sidebar-layout-state]')?.dataset.sidebarLayoutOpen==='false'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
          }
        ]
      },
      {
        "name": "reopened",
        "steps": [
          {
            "action": "click",
            "selector": "[data-sidebar-layout-toggle]"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-sidebar-layout-state]')?.dataset.sidebarLayoutOpen==='true'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
          }
        ]
      }
    ]
  }
}
