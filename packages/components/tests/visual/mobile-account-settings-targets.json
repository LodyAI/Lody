  "states": {
    "mobile-ownedmobileaccountsettingsmigration--account": [
      {
        "name": "name-edit",
        "steps": [
          {
            "action": "click",
            "role": "button",
            "name": "Edit name",
            "exact": true
          },
          {
            "action": "fill",
            "selector": "#profile-name-mobile",
            "value": "Renamed synthetic account 中文"
          }
        ]
      },
      {
        "name": "name-saving",
        "steps": [
          {
            "action": "press",
            "selector": "#profile-name-mobile",
            "key": "Enter"
          },
          {
            "action": "visible",
            "selector": "[data-mobile-account-pending^=\"Account name\"]"
          },
          {
            "action": "disabled",
            "role": "button",
            "name": "Edit name"
          }
        ]
      },
      {
        "name": "name-completed",
        "steps": [
          {
            "action": "click",
            "selector": "[data-complete-operation]"
          },
          {
            "action": "visible",
            "selector": "[data-mobile-account-result]:text-is(\"Completed Account name Renamed synthetic account 中文\")"
          }
        ]
      },
      {
        "name": "key-dialog",
        "steps": [
          {
            "action": "click",
            "role": "button",
            "name": "Create token",
            "exact": true
          },
          {
            "action": "visible",
            "selector": "[role=\"dialog\"]"
          },
          {
            "action": "fill",
            "selector": "#cli-api-key-note",
            "value": "Synthetic long token note 中文边界"
          }
        ]
      },
      {
        "name": "key-pending",
