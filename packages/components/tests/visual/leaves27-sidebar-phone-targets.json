  "ready": {
    "migration-ownedlegacysidebar--offcanvas-left": [
      {
        "action": "waitForFunction",
        "expression": "() => {const p=document.querySelector('[data-sidebar-fixture-state]');if(!p||p.dataset.sidebarFixtureMobile!=='true')return false;if(p.dataset.sidebarFixtureOpen!=='false')return false;const panel=document.querySelector('[data-mobile=true]');if(panel&&panel.getBoundingClientRect().width>0)return false;return document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'));}"
      }
    ],
