          {
            "action": "hover",
            "selector": "[data-case=sm]"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-case=sm]').matches(':hover')"
          }
        ]
      },
      {
        "name": "keyboard-activated",
