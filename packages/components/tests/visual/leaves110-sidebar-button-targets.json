  "ready": {
    "migration-ownedlegacysidebarbutton--natural": [
      {
        "action": "waitForFunction",
        "expression": "() => document.documentElement.classList.contains('dark')===matchMedia('(prefers-color-scheme: dark)').matches"
      },
      {
        "action": "waitForFunction",
        "expression": "() => {const p=document.querySelector('[data-sidebar-button-state]');return !!p&&p.dataset.sidebarButtonState==='expanded'&&p.dataset.sidebarButtonMobile==='false'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'));}"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.querySelectorAll('[data-sidebar=menu-button]').length===13"
      }
    ],
