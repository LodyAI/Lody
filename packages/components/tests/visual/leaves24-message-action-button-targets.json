  "ready": {
    "migration-ownedmessageactionbuttondimensions--user-actions": [
      {
        "action": "visible",
        "selector": "[data-clipboard-ready=true]"
      },
      {
        "action": "click",
        "selector": "[data-user-case=ordinary] [data-testid=user-message-metadata]"
      },
      {
        "action": "hover",
        "selector": "[data-user-case=ordinary] [data-testid=user-message-metadata]"
      },
      {
        "action": "waitForFunction",
        "expression": "() => {const c=document.querySelector('[data-user-case=ordinary] [data-user-message-actions]');const b=c?[...c.querySelectorAll('button')]:[];return c&&getComputedStyle(c).visibility==='visible'&&b.length===3&&b.every(e=>getComputedStyle(e).opacity==='1')&&!document.querySelector('[data-message-button-dimensions] button[data-popup-open]');}"
      },
      {
        "action": "waitForFunction",
        "expression": "() => {const b=[...document.querySelectorAll('[data-user-case=ordinary] [data-user-message-actions] button')];return b.length===3&&b.every(e=>getComputedStyle(e).width==='28px'&&getComputedStyle(e).height==='28px');}"
      }
    ],
