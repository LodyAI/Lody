            "action": "waitForFunction",
            "expression": "() => !document.querySelector('textarea')&&document.querySelector('[data-user-case=ordinary]').dataset.saved===''&&!document.querySelector('[data-user-case=ordinary]').textContent.includes('Discarded synthetic draft')"
