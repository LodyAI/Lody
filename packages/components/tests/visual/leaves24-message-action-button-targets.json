          {
            "action": "visible",
            "selector": "textarea"
          },
          {
            "action": "waitForFunction",
            "expression": "() => {const t=document.querySelector('textarea');return t?.value==='Synthetic instruction for message button dimensions.'&&!document.querySelector('[data-user-message-actions]')&&[...document.querySelectorAll('button')].some(b=>b.textContent==='Send'&&!b.disabled);}"
          }
        ]
