        "expression": "() => {const a=[...document.querySelectorAll('[data-footer-case=actions] button')].filter(b=>b.textContent.includes('synthetic action'));const c=document.querySelector('[data-footer-case=streaming] button[aria-label]');return a.length===2&&a.every(b=>!b.disabled&&getComputedStyle(b).height==='32px')&&getComputedStyle(c).width==='28px'&&getComputedStyle(c).height==='28px';}"
      },
      {
        "action": "movePointer",
        "x": 1,
        "y": 1
      }
    ],
