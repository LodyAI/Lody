{
  "viewports": [
    {
      "name": "phone390",
      "width": 390,
      "height": 900,
      "device": "iPhone 13"
    },
    {
      "name": "at-md768",
      "width": 768,
      "height": 1000
    }
  ],
  "themes": ["light", "dark"],
  "locale": "en",
  "reducedMotion": "reduce",
  "ids": ["sessions-previewconnectionstatus--connected"],
  "ready": {
    "sessions-previewconnectionstatus--connected": [
      {
        "action": "waitForFunction",
        "expression": "()=>{const t=document.querySelector('[data-testid=preview-status-trigger]'),p=document.querySelector('[role=dialog]'),h=p&&document.getElementById(p.getAttribute('aria-labelledby')),s=p&&getComputedStyle(p);return t?.getAttribute('aria-expanded')==='true'&&!!h&&h.textContent===t.getAttribute('aria-label')&&s.opacity==='1'&&s.visibility==='visible'&&(!s.transform||s.transform==='none'||s.transform==='matrix(1, 0, 0, 1, 0, 0)')&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'));}"
      }
    ]
  },
  "states": {
    "sessions-previewconnectionstatus--connected": [
      {
        "name": "escape-closed",
        "steps": [
          {
            "action": "press",
            "selector": "[role=dialog]",
            "key": "Escape"
          },
          {
            "action": "waitForFunction",
            "expression": "()=>!document.querySelector('[role=dialog]')&&document.querySelector('[data-testid=preview-status-trigger]').getAttribute('aria-expanded')==='false'"
          }
        ]
      },
      {
        "name": "keyboard-reopened",
        "steps": [
          {
            "action": "press",
            "selector": "[data-testid=preview-status-trigger]",
            "key": "Enter"
          },
          {
            "action": "waitForFunction",
            "expression": "()=>{const t=document.querySelector('[data-testid=preview-status-trigger]'),p=document.querySelector('[role=dialog]'),h=p&&document.getElementById(p.getAttribute('aria-labelledby')),s=p&&getComputedStyle(p);return t?.getAttribute('aria-expanded')==='true'&&!!h&&h.textContent===t.getAttribute('aria-label')&&s.opacity==='1'&&s.visibility==='visible'&&(!s.transform||s.transform==='none'||s.transform==='matrix(1, 0, 0, 1, 0, 0)')&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'));}"
          }
        ]
      }
    ]
  }
}
