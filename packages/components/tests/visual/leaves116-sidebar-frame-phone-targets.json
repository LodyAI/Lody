        "action": "waitForFunction",
        "expression": "() => document.querySelector('[data-frame-state]')?.dataset.frameMobile==='true'"
      },
      {
        "action": "focus",
        "selector": "[data-frame-toggle]"
      },
      {
        "action": "press",
        "selector": "[data-frame-toggle]",
        "key": "Control+b"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.querySelector('[data-frame-state]').dataset.frameOpen==='false'"
      },
      {
        "action": "press",
        "selector": "[data-frame-toggle]",
        "key": "Enter"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.querySelector('[data-frame-state]').dataset.frameOpen==='true'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
      },
      {
        "action": "waitForFunction",
        "expression": "() => {const p=[...document.querySelectorAll('[data-frame-part]')];return p.length===6&&p.filter(e=>e.dataset.framePart!=='sidebar').every(e=>e.dataset.frameRefTag===e.tagName)&&document.querySelector('[data-frame-slot]')?.tagName==='A'}"
      }
    ],
