      }
    ]
  },
  "states": {
    "migration-ownedmobilehistoryspinner--import": [
      {
        "name": "pending",
        "steps": [
          {
            "action": "click",
            "selector": ".mobile-acp-history-sheet button:has(svg):text-matches(\"Import\")"
          },
          {
            "action": "waitForFunction",
            "expression": "() => {const fixture=document.querySelector('[data-owned-history-fixture]'),panel=document.querySelector('.mobile-acp-history-sheet'),marks=panel?.querySelectorAll('[data-slot=spinner]');if(fixture?.dataset.pending!=='true'||marks?.length!==1)return false;const mark=marks[0],r=mark.getBoundingClientRect(),css=getComputedStyle(mark);return css.width==='16px'&&css.height==='16px'&&r.top>=0&&r.bottom<=innerHeight&&r.left>=0&&r.right<=innerWidth&&mark.closest('button')?.disabled===true;}"
          }
        ]
      },
      {
        "name": "completed-reopened",
        "steps": [
          {
            "action": "click",
            "selector": ".mobile-acp-history-sheet button[aria-label=\"Close\"]"
          },
          {
            "action": "waitForFunction",
            "expression": "() => !document.querySelector('.mobile-acp-history-sheet')"
          },
          {
            "action": "click",
            "role": "button",
            "name": "Complete synthetic history operation"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-owned-history-fixture]')?.dataset.pending==='false'"
          },
          {
            "action": "click",
            "role": "button",
            "name": "Open history fixture"
          },
          {
            "action": "waitForFunction",
            "expression": "() => {const p=document.querySelector('.mobile-acp-history-sheet');return p&&getComputedStyle(p).opacity==='1'&&p.getBoundingClientRect().height>0&&!p.querySelector('[data-slot=spinner]');}"
          }
        ]
      }
    ],
