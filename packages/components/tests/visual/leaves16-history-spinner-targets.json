  "ids": [
    "migration-ownedmobilehistoryspinner--import",
    "migration-ownedmobilehistoryspinner--resolve",
    "migration-ownedmobilehistoryspinner--import-root-spacing",
    "migration-ownedmobilehistoryspinner--resolve-root-spacing"
  ],
  "ready": {
    "migration-ownedmobilehistoryspinner--import": [
      {
        "action": "waitForFunction",
        "expression": "() => { const panel=document.querySelector('.mobile-acp-history-sheet');if(!panel||getComputedStyle(panel).opacity!=='1')return false;const r=panel.getBoundingClientRect();return r.width>0&&r.height>0&&r.top>=0&&r.bottom<=innerHeight+1&&!document.querySelector('.mobile-acp-history-sheet [data-slot=spinner]'); }"
      }
    ],
    "migration-ownedmobilehistoryspinner--resolve": [
      {
        "action": "waitForFunction",
        "expression": "() => { const panel=document.querySelector('.mobile-acp-history-sheet');if(!panel||getComputedStyle(panel).opacity!=='1')return false;const r=panel.getBoundingClientRect();return r.width>0&&r.height>0&&r.top>=0&&r.bottom<=innerHeight+1&&!document.querySelector('.mobile-acp-history-sheet [data-slot=spinner]'); }"
      }
    ],
    "migration-ownedmobilehistoryspinner--import-root-spacing": [
      {
        "action": "waitForFunction",
