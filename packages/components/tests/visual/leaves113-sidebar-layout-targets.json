  "states": {
    "migration-ownedlegacysidebarlayout--natural": [
      {
        "name": "keyboard-native",
        "steps": [
          {
            "action": "focus",
            "selector": "[data-layout-action=native]"
          },
          {
            "action": "press",
            "selector": "[data-layout-action=native]",
            "key": "Enter"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-sidebar-layout-event]').textContent==='Native'"
          }
        ]
      },
      {
        "name": "keyboard-slot",
        "steps": [
          {
            "action": "focus",
            "selector": "[data-layout-action=slot]"
