{
  "viewports": [
    {
      "name": "desktop",
      "width": 1280,
      "height": 1000
    }
  ],
  "themes": ["light", "dark"],
  "reducedMotion": "reduce",
  "ids": [
    "migration-ownedlegacysidebarlayout--natural",
    "migration-ownedlegacysidebarlayout--opaque",
    "migration-ownedlegacysidebarlayout--utility",
    "migration-ownedlegacysidebarlayout--wildcard",
    "migration-ownedlegacysidebarlayout--scoped"
  ],
  "ready": {
    "migration-ownedlegacysidebarlayout--natural": [
      {
        "action": "waitForFunction",
        "expression": "() => document.documentElement.classList.contains('dark')===matchMedia('(prefers-color-scheme: dark)').matches"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.querySelectorAll('[data-layout-part]').length===5&&document.querySelector('[data-sidebar-layout-state]')?.dataset.sidebarLayoutMobile==='false'"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.querySelector('[data-sidebar-layout-state]')?.dataset.sidebarLayoutState==='expanded'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
      }
    ],
    "migration-ownedlegacysidebarlayout--opaque": [
