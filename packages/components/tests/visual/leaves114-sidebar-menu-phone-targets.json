{
  "viewports": [
    {
      "name": "phone",
      "device": "iPhone 13",
      "width": 390,
      "height": 1000
    }
  ],
  "themes": ["light", "dark"],
  "reducedMotion": "reduce",
  "ids": [
    "migration-ownedlegacysidebarmenuparts--natural",
    "migration-ownedlegacysidebarmenuparts--scoped"
  ],
  "ready": {
    "migration-ownedlegacysidebarmenuparts--natural": [
      {
        "action": "waitForFunction",
        "expression": "() => document.documentElement.classList.contains('dark')===matchMedia('(prefers-color-scheme: dark)').matches"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.querySelector('[data-sidebar-menu-state]')?.dataset.sidebarMenuMobile==='true'"
      },
      {
        "action": "click",
        "selector": "[data-sidebar-menu-toggle]"
      },
      {
        "action": "waitForFunction",
        "expression": "() => {const p=[...document.querySelectorAll('[data-menu-part]')],s=[...document.querySelectorAll('[data-menu-slot-child]')];return p.length===15&&p.every(e=>e.dataset.menuRefTag===e.tagName)&&s.length===4&&s.every(e=>e.hasAttribute('data-menu-part'));}"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.querySelector('[data-sidebar-menu-state]')?.dataset.sidebarMenuOpen==='true'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
      }
    ],
    "migration-ownedlegacysidebarmenuparts--scoped": [
      {
        "action": "waitForFunction",
        "expression": "() => document.documentElement.classList.contains('dark')===matchMedia('(prefers-color-scheme: dark)').matches"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.querySelector('[data-sidebar-menu-state]')?.dataset.sidebarMenuMobile==='true'"
      },
      {
        "action": "click",
        "selector": "[data-sidebar-menu-toggle]"
      },
      {
        "action": "waitForFunction",
        "expression": "() => {const p=[...document.querySelectorAll('[data-menu-part]')],s=[...document.querySelectorAll('[data-menu-slot-child]')];return p.length===15&&p.every(e=>e.dataset.menuRefTag===e.tagName)&&s.length===4&&s.every(e=>e.hasAttribute('data-menu-part'));}"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.querySelector('[data-sidebar-menu-state]')?.dataset.sidebarMenuOpen==='true'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
      }
    ]
  },
  "states": {
    "migration-ownedlegacysidebarmenuparts--natural": [
      {
        "name": "slot-keyboard",
        "steps": [
          {
            "action": "focus",
            "selector": "[data-menu-last-slot]"
          },
          {
            "action": "press",
            "selector": "[data-menu-last-slot]",
            "key": "Enter"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-sidebar-menu-event]').textContent==='Slot child'"
          }
        ]
      },
      {
        "name": "closed",
        "steps": [
          {
            "action": "press",
            "selector": "[data-menu-last-slot]",
            "key": "Escape"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-sidebar-menu-state]')?.dataset.sidebarMenuOpen==='false'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
          }
        ]
      },
      {
        "name": "reopened",
        "steps": [
          {
            "action": "click",
            "selector": "[data-sidebar-menu-toggle]"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-sidebar-menu-state]')?.dataset.sidebarMenuOpen==='true'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
          }
        ]
      }
    ],
    "migration-ownedlegacysidebarmenuparts--scoped": [
      {
        "name": "slot-keyboard",
        "steps": [
          {
            "action": "focus",
            "selector": "[data-menu-last-slot]"
          },
          {
            "action": "press",
            "selector": "[data-menu-last-slot]",
            "key": "Enter"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-sidebar-menu-event]').textContent==='Slot child'"
          }
        ]
      },
      {
        "name": "closed",
        "steps": [
          {
            "action": "press",
            "selector": "[data-menu-last-slot]",
            "key": "Escape"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-sidebar-menu-state]')?.dataset.sidebarMenuOpen==='false'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
          }
        ]
      },
      {
        "name": "reopened",
        "steps": [
          {
            "action": "click",
            "selector": "[data-sidebar-menu-toggle]"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-sidebar-menu-state]')?.dataset.sidebarMenuOpen==='true'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
          }
        ]
      }
    ]
  }
}
