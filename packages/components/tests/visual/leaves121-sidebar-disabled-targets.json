    "migration-ownedlegacysidebardisabled--natural": [
      {
        "action": "waitForFunction",
        "expression": "() => window.__STORYBOOK_PREVIEW__?.currentRender?.phase==='finished'"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.documentElement.classList.contains('dark')===matchMedia('(prefers-color-scheme: dark)').matches"
      },
      {
        "action": "waitForFunction",
        "expression": "() => [...document.querySelectorAll('[data-state-part]')].length===9&&[...document.querySelectorAll('[data-state-part]')].every(e=>e.dataset.stateRefTag===e.tagName)&&document.querySelector('[data-state-part=slot-disabled]').tagName==='BUTTON'&&document.querySelector('[data-state-part=aria-anchor]').tagName==='A'&&document.fonts.status==='loaded'"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.querySelector('[data-state-part=native-disabled]').matches(':disabled')&&!document.querySelector('[data-state-part=aria-anchor]').matches(':disabled')&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
      }
    ],
