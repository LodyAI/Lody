    "migration-ownedlegacysidebardisabled--natural": [
      {
        "name": "keyboard-enabled",
        "steps": [
          {
            "action": "focus",
            "selector": "[data-state-part=enabled]"
          },
          {
            "action": "press",
            "selector": "[data-state-part=enabled]",
            "key": "Enter"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-state-events]').dataset.stateEvents==='1'&&document.querySelector('[data-state-events]').dataset.stateLast==='enabled'"
