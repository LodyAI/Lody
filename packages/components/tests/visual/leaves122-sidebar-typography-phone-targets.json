{
  "viewports": [
    {
      "name": "phone",
      "device": "iPhone 13",
      "width": 390,
      "height": 1000
    }
  ],
  "themes": ["light", "dark"],
  "reducedMotion": "reduce",
  "ids": [
    "migration-ownedlegacysidebartypography--natural",
    "migration-ownedlegacysidebartypography--local-vars",
    "migration-ownedlegacysidebartypography--local-leading"
  ],
  "ready": {
    "migration-ownedlegacysidebartypography--natural": [
      {
        "action": "waitForFunction",
        "expression": "() => window.__STORYBOOK_PREVIEW__?.currentRender?.phase==='finished'"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.documentElement.classList.contains('dark')===matchMedia('(prefers-color-scheme: dark)').matches"
      },
      {
        "action": "waitForFunction",
        "expression": "() => {const es=[...document.querySelectorAll('[data-type-part]')];return es.length===14&&es.every(e=>e.dataset.typeRefTag===e.tagName)&&document.querySelector('[data-type-part=button-slot]').tagName==='BUTTON'&&document.querySelector('[data-type-part=sub-slot]').tagName==='A'}"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.querySelector('[data-type-fixture]').dataset.typeActive==='false'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
      }
    ],
    "migration-ownedlegacysidebartypography--local-vars": [
      {
        "action": "waitForFunction",
