      },
      {
        "action": "waitForFunction",
        "expression": "() => document.querySelector('[data-type-fixture]').dataset.typeActive==='false'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
      }
    ]
  },
  "states": {
    "migration-ownedlegacysidebartypography--natural": [
      {
        "name": "active-prop",
        "steps": [
          {
            "action": "focus",
            "selector": "[data-type-toggle]"
          },
          {
            "action": "press",
            "selector": "[data-type-toggle]",
            "key": "Enter"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-type-fixture]').dataset.typeActive==='true'&&[...document.querySelectorAll('[data-type-part^=button-]:not([data-type-part=button-slot])')].every(e=>e.dataset.active==='true')&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
          }
        ]
