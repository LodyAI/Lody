      {
        "action": "waitForFunction",
        "expression": "() => document.querySelector('[data-stuck-banner-ready]')?.dataset.stuckBannerReady==='true'"
      },
      {
        "action": "waitForFunction",
        "expression": "() => {const marks=[...document.querySelectorAll(\"button[aria-label=\\\"Dismiss\\\"]\")];return marks.length===1&&marks.every(m=>{const c=getComputedStyle(m),v=c.getPropertyValue('--spacing').trim(),unit=parseFloat(v)*(v.endsWith('rem')?parseFloat(getComputedStyle(document.documentElement).fontSize):1);const r=m.getBoundingClientRect();return r.width>0&&r.height>0&&r.left>=0&&r.top>=0&&r.right<=innerWidth&&r.bottom<=innerHeight&&Number(c.opacity)>0&&Math.abs(parseFloat(c.height)-unit*6)<0.02&&Math.abs(parseFloat(c.width)-unit*6)<0.02;});}"
      },
      {
        "action": "waitForFunction",
        "expression": "() => {const marks=[...document.querySelectorAll(\"[role=status] button:not([aria-label])\")];return marks.length===1&&marks.every(m=>{const c=getComputedStyle(m),v=c.getPropertyValue('--spacing').trim(),unit=parseFloat(v)*(v.endsWith('rem')?parseFloat(getComputedStyle(document.documentElement).fontSize):1);const r=m.getBoundingClientRect();return r.width>0&&r.height>0&&r.left>=0&&r.top>=0&&r.right<=innerWidth&&r.bottom<=innerHeight&&Number(c.opacity)>0&&Math.abs(parseFloat(c.height)-unit*7)<0.02;});}"
      }
    ],
    "preview-visualannotationdraftcomposer--ready": [
      {
        "action": "waitForFunction",
        "expression": "() => {const marks=[...document.querySelectorAll(\"[data-lody-visual-comment-draft] button[aria-label=\\\"Cancel\\\"]\")];return marks.length===1&&marks.every(m=>{const c=getComputedStyle(m),v=c.getPropertyValue('--spacing').trim(),unit=parseFloat(v)*(v.endsWith('rem')?parseFloat(getComputedStyle(document.documentElement).fontSize):1);const r=m.getBoundingClientRect();return r.width>0&&r.height>0&&r.left>=0&&r.top>=0&&r.right<=innerWidth&&r.bottom<=innerHeight&&Number(c.opacity)>0&&Math.abs(parseFloat(c.height)-unit*6)<0.02&&Math.abs(parseFloat(c.width)-unit*6)<0.02;});}"
