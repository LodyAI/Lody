  "states": {
    "migration-ownedlegacysidebaredge--natural": [
      {
        "name": "painted-rail-hover",
        "steps": [
          {
            "action": "hover",
            "selector": "[data-edge-part=rail]"
          },
          {
            "action": "waitForFunction",
            "expression": "() => {const e=document.querySelector('[data-edge-part=rail]'),r=e.getBoundingClientRect();return e.matches(':hover')&&r.width>0&&r.height>0&&document.elementFromPoint(r.x+r.width/2,r.y+r.height/2)===e&&getComputedStyle(e,'::after').content!=='none'}"
          }
        ]
      },
      {
        "name": "rail-click-closed",
        "steps": [
          {
            "action": "click",
            "selector": "[data-edge-part=rail]"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-edge-state]').dataset.edgeState==='collapsed'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
          },
          {
            "action": "movePointer",
            "x": 1100,
            "y": 950
          },
          {
            "action": "waitForFunction",
            "expression": "() => !document.querySelector('[data-edge-part=rail]').matches(':hover')&&getComputedStyle(document.querySelector('[data-edge-part=rail]'),'::after').backgroundColor==='rgba(0, 0, 0, 0)'"
          }
        ]
      },
      {
        "name": "toggle-restored",
        "steps": [
          {
            "action": "focus",
            "selector": "[data-edge-toggle]"
          },
          {
            "action": "press",
            "selector": "[data-edge-toggle]",
            "key": "Enter"
          },
          {
            "action": "waitForFunction",
            "expression": "() => document.querySelector('[data-edge-state]').dataset.edgeState==='expanded'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
          }
        ]
