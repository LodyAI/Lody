    "migration-ownedlegacysidebaredge--natural": [
      {
        "action": "waitForFunction",
        "expression": "() => window.__STORYBOOK_PREVIEW__?.currentRender?.phase==='finished'"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.documentElement.classList.contains('dark')===matchMedia('(prefers-color-scheme: dark)').matches"
      },
      {
        "action": "waitForFunction",
        "expression": "() => [...document.querySelectorAll('[data-edge-part]')].length===2&&[...document.querySelectorAll('[data-edge-part]')].every(e=>e.dataset.edgeRefTag===e.tagName)&&document.querySelector('[data-edge-slot]')?.tagName==='A'"
      },
      {
        "action": "waitForFunction",
        "expression": "() => document.querySelector('[data-edge-state]').dataset.edgeState==='expanded'&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'))"
      }
    ],
