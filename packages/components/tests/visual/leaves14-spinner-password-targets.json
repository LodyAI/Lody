{
  "viewports": [
    {
      "name": "desktop",
      "width": 1280,
      "height": 900
    },
    {
      "name": "narrow",
      "width": 320,
      "height": 900,
      "device": "iPhone SE"
    }
  ],
  "themes": ["light", "dark"],
  "reducedMotion": "reduce",
  "locale": "en",
  "ids": [
    "components-forgotpasswordpage--submitting",
    "components-forgotpasswordpage--scoped-submitting",
    "components-resetpasswordpage--submitting",
    "components-resetpasswordpage--scoped-submitting"
  ],
  "ready": {
    "components-forgotpasswordpage--submitting": [
      {
        "action": "visible",
        "selector": "[data-slot=spinner]"
      },
      {
        "action": "waitForFunction",
        "expression": "() => {const box=document.querySelector('[data-slot=spinner]'),form=box?.closest('form');return box&&box.closest('button')?.disabled&&form?.getAttribute('aria-busy')==='true'&&getComputedStyle(box).width==='16px'&&getComputedStyle(box).height==='16px'&&getComputedStyle(box).marginRight==='8px'&&box.firstElementChild?.getAttribute('aria-label')==='Loading'&&[...form.querySelectorAll('input[type=email],input[type=password]')].every(input=>input.disabled);}"
      }
    ],
    "components-forgotpasswordpage--scoped-submitting": [
      {
        "action": "visible",
        "selector": "[data-slot=spinner]"
      },
      {
        "action": "waitForFunction",
        "expression": "() => {const box=document.querySelector('[data-slot=spinner]'),form=box?.closest('form');return box&&box.closest('button')?.disabled&&form?.getAttribute('aria-busy')==='true'&&getComputedStyle(box).width==='24px'&&getComputedStyle(box).height==='24px'&&getComputedStyle(box).marginRight==='8px'&&box.firstElementChild?.getAttribute('aria-label')==='Loading'&&[...form.querySelectorAll('input[type=email],input[type=password]')].every(input=>input.disabled);}"
      }
    ],
    "components-resetpasswordpage--submitting": [
      {
        "action": "visible",
        "selector": "[data-slot=spinner]"
      },
      {
        "action": "waitForFunction",
        "expression": "() => {const box=document.querySelector('[data-slot=spinner]'),form=box?.closest('form');return box&&box.closest('button')?.disabled&&form?.getAttribute('aria-busy')==='true'&&getComputedStyle(box).width==='16px'&&getComputedStyle(box).height==='16px'&&getComputedStyle(box).marginRight==='8px'&&box.firstElementChild?.getAttribute('aria-label')==='Loading'&&[...form.querySelectorAll('input[type=email],input[type=password]')].every(input=>input.disabled);}"
      }
    ],
    "components-resetpasswordpage--scoped-submitting": [
      {
        "action": "visible",
        "selector": "[data-slot=spinner]"
      },
      {
        "action": "waitForFunction",
        "expression": "() => {const box=document.querySelector('[data-slot=spinner]'),form=box?.closest('form');return box&&box.closest('button')?.disabled&&form?.getAttribute('aria-busy')==='true'&&getComputedStyle(box).width==='24px'&&getComputedStyle(box).height==='24px'&&getComputedStyle(box).marginRight==='8px'&&box.firstElementChild?.getAttribute('aria-label')==='Loading'&&[...form.querySelectorAll('input[type=email],input[type=password]')].every(input=>input.disabled);}"
      }
    ]
  }
}
