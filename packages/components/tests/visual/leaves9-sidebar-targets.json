            "expression": "() => { const p=document.querySelector('[data-sidebar-fixture-state]');if(!p)return false; if(p.dataset.sidebarFixtureMobile!=='true')return p.dataset.sidebarFixtureState==='collapsed'; const panel=document.querySelector('[data-mobile=true]');if(!panel||p.dataset.sidebarFixtureOpen!=='true')return false;const r=panel.getBoundingClientRect(),s=getComputedStyle(panel);return s.opacity==='1'&&r.width>0&&r.height>0&&r.left>=-1&&r.right<=innerWidth+1; }"
          }
        ]
