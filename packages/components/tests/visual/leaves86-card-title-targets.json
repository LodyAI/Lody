  "states": {
    "components-forgotpasswordpage--default": [
      {
        "name": "email-input-focused",
        "steps": [
          {
            "action": "focus",
            "selector": "#forgot-password-email"
          },
          {
            "action": "waitForFunction",
            "expression": "document.activeElement?.id === \"forgot-password-email\""
          }
        ]
      }
    ],
    "components-resetpasswordpage--default": [
      {
        "name": "password-visibility-toggle",
        "steps": [
          {
            "action": "click",
            "selector": "button[aria-label=\"Show password\"]",
            "index": 0
          },
          {
            "action": "waitForFunction",
            "expression": "document.querySelector(\"#reset-password-new\")?.type === \"text\""
          }
        ]
      }
    ],
    "pages-completeemailpage--empty": [
      {
        "name": "email-input-focused",
        "steps": [
          {
            "action": "focus",
            "selector": "#email"
          },
          {
            "action": "waitForFunction",
            "expression": "document.activeElement?.id === \"email\""
          }
        ]
      }
    ]
  }
