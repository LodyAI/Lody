      {
        "action": "visible",
        "selector": "diffs-container [data-line]",
        "index": 0
      },
      {
        "action": "waitForFunction",
        "expression": "()=>{const root=document.querySelector('[data-diff-migration]'),h=root?.querySelector('[aria-expanded]'),img=root?.querySelector('img');return !!h&&h.getAttribute('aria-expanded')==='true'&&(!img||(img.complete&&img.naturalWidth>0))&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'));}"
      }
