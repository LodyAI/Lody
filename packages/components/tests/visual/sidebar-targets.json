    "components-sidebar-folded-group-status--side-by-side",
    "components-sidebarfooter--default",
    "components-sidebarfooter--long-name",
    "components-sidebarfooter--syncing",
    "components-sidebarfooter--local-identity",
    "projects-localprojectremovalux--project-removing",
    "projects-localprojectremovalux--project-waiting-for-device",
    "projects-localprojectremovalux--desktop-remove-confirmation",
    "projects-localprojectremovalux--cleanup-result-visible",
    "components-sidebar-migration--row-anatomy",
    "components-sidebar-migration--large-interface-type",
    "components-sidebar-migration--updated-loading",
    "components-sidebar-migration--updated-empty",
    "components-sidebar-migration--updated-overflow"
  ],
  "allowBlankIds": [
    "components-sessionlist--loading",
    "components-sidebar-migration--updated-loading"
  ],
  "states": {
    "components-sidebar-migration--row-anatomy": [
      {
        "name": "opener-collapsed",
        "steps": [
          {
            "action": "press",
            "role": "button",
            "name": "Collapse fixture children",
            "key": "Enter"
          },
          {
            "action": "hidden",
            "selector": "[data-fixture-row=\"child-first\"]"
          }
        ]
      },
      {
        "name": "opener-expanded",
        "steps": [
          {
            "action": "press",
            "role": "button",
            "name": "Expand fixture children",
            "key": "Enter"
          },
          {
            "action": "visible",
            "selector": "[data-fixture-row=\"child-first\"]"
          }
        ]
      },
      {
        "name": "child-hover",
        "steps": [
          {
            "action": "hover",
            "selector": "[data-fixture-row=\"child-first\"]"
          }
        ]
      },
      {
        "name": "child-menu",
        "steps": [
          {
            "action": "click",
            "role": "button",
            "name": "Menu Check nested row alignment"
          },
          {
            "action": "visible",
            "role": "menuitem",
            "name": "Inspect fixture session"
          }
        ]
      },
      {
        "name": "keyboard-disclosure",
        "steps": [
          {
            "action": "press",
            "role": "menuitem",
            "name": "Inspect fixture session",
            "key": "Escape"
          },
          {
            "action": "movePointer",
            "x": -10,
            "y": -10
          },
          {
            "action": "focus",
            "role": "button",
            "name": "Collapse fixture children"
          }
        ]
      },
      {
        "name": "archive-hover",
        "steps": [
          {
            "action": "hover",
            "selector": "[data-fixture-row=\"plain\"]"
          }
        ]
      },
      {
        "name": "archive-confirm",
        "steps": [
          {
            "action": "click",
            "role": "button",
            "name": "Archive Resting session"
          }
        ]
      },
      {
        "name": "archive-committed",
        "steps": [
          {
            "action": "click",
            "role": "button",
            "name": "Confirm Archive Resting session"
          },
          {
            "action": "hidden",
            "selector": "[data-fixture-row=\"plain\"]"
          }
        ]
      }
    ],
    "components-sidebar-migration--large-interface-type": [
      {
        "name": "opener-collapsed",
        "steps": [
          {
            "action": "press",
            "role": "button",
            "name": "Collapse fixture children",
            "key": "Enter"
          },
          {
            "action": "hidden",
            "selector": "[data-fixture-row=\"child-first\"]"
          }
        ]
      },
      {
        "name": "opener-expanded",
        "steps": [
          {
            "action": "press",
            "role": "button",
            "name": "Expand fixture children",
            "key": "Enter"
          },
          {
            "action": "visible",
            "selector": "[data-fixture-row=\"child-first\"]"
          }
        ]
      },
      {
        "name": "child-hover",
        "steps": [
          {
            "action": "hover",
            "selector": "[data-fixture-row=\"child-first\"]"
          }
        ]
      },
      {
        "name": "child-menu",
        "steps": [
          {
            "action": "click",
            "role": "button",
            "name": "Menu Check nested row alignment"
          },
          {
            "action": "visible",
            "role": "menuitem",
            "name": "Inspect fixture session"
          }
        ]
      },
      {
        "name": "keyboard-disclosure",
        "steps": [
          {
            "action": "press",
            "role": "menuitem",
            "name": "Inspect fixture session",
            "key": "Escape"
          },
          {
            "action": "movePointer",
            "x": -10,
            "y": -10
          },
          {
            "action": "focus",
            "role": "button",
            "name": "Collapse fixture children"
          }
        ]
      },
      {
        "name": "archive-hover",
        "steps": [
          {
            "action": "hover",
            "selector": "[data-fixture-row=\"plain\"]"
          }
        ]
      },
      {
        "name": "archive-confirm",
        "steps": [
          {
            "action": "click",
            "role": "button",
            "name": "Archive Resting session"
          }
        ]
      },
      {
        "name": "archive-committed",
        "steps": [
          {
            "action": "click",
            "role": "button",
            "name": "Confirm Archive Resting session"
          },
          {
            "action": "hidden",
            "selector": "[data-fixture-row=\"plain\"]"
          }
        ]
      }
    ],
    "components-sidebar-migration--updated-loading": [
      {
        "name": "skeleton-visible",
        "steps": [
          {
            "action": "visible",
            "selector": "[data-sidebar-loading-skeleton]"
          }
        ]
      }
    ]
  },
  "ready": {
    "components-sidebarfooter--default": [
      {
        "action": "visible",
        "selector": "[data-shape=\"tile\"] img"
      }
    ],
    "components-sidebarfooter--long-name": [
      {
        "action": "visible",
        "selector": "[data-shape=\"tile\"] img"
      }
    ],
    "components-sidebarfooter--local-identity": [
