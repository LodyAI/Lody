      {
        "name": "positioned-header-with-real-scroll-owner",
        "steps": [
          {
            "action": "waitForFunction",
            "expression": "() => {const s=document.querySelector('.crh-group-section'),h=s.querySelector(':scope>header'),m=document.querySelector('.crh-main'),b=s.querySelector('.crh-block-header'),desktop=matchMedia('(min-width:1024px)').matches;if(desktop){const both=document.querySelectorAll('.crh-group-section').length>1,headerReady=Math.abs(h.getBoundingClientRect().top-parseFloat(getComputedStyle(h).top))<.01,fileReady=Math.abs(b.getBoundingClientRect().top-parseFloat(getComputedStyle(b).top))<.01;if(!headerReady||(both&&!fileReady)){const target=both?b:h;const previous=m.scrollTop;m.scrollBy(0,target.getBoundingClientRect().top-parseFloat(getComputedStyle(target).top)+20);if(!both&&m.scrollTop===previous&&m.scrollTop>=m.scrollHeight-m.clientHeight-.5){const r=h.getBoundingClientRect();return r.top>=0&&r.bottom<=innerHeight;}return false;}return h.getBoundingClientRect().bottom<=innerHeight;}const r=h.getBoundingClientRect();if(Math.abs(r.top-100)>.6){scrollBy(0,r.top-100);return false;}return r.top>=0&&r.bottom<=innerHeight;}"
          },
