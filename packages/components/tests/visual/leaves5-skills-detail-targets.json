          {
            "action": "visible",
            "selector": "[data-owned-skills-fixture] > div > header > button"
          }
        ]
      },
      {
        "name": "detail-back",
        "steps": [
          {
            "action": "click",
            "selector": "[data-owned-skills-fixture] > div > header > button"
          },
          {
            "action": "hidden",
            "role": "heading",
            "name": "When to use",
            "exact": true
          },
          {
            "action": "hidden",
            "selector": "[data-owned-skills-fixture] > div > header > button"
          },
          {
            "action": "visible",
