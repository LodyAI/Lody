            "expression": "()=>{const root=document.documentElement,wanted=new URL(location.href).searchParams.get('globals')?.match(/theme:(light|dark)/)?.[1],b=document.querySelector(\"button[aria-label=\\\"Preview HTML (runs scripts)\\\"]\"),p=document.querySelector(\"div[data-base-ui-focusable][data-side]:not([role])\");if(!b||!p||root.classList.contains('dark')!==(wanted==='dark')||b.getAttribute('aria-pressed')!==\"false\")return false;const c=getComputedStyle(p),r=p.getBoundingClientRect();return p.textContent===\"Preview HTML (runs scripts)\"&&c.fontSize==='12px'&&c.lineHeight==='16px'&&c.opacity==='1'&&!p.hasAttribute('data-starting-style')&&!p.hasAttribute('data-ending-style')&&r.width>0&&r.height>0&&r.left>=-.01&&r.right<=innerWidth+.01&&r.top>=-.01&&r.bottom<=innerHeight+.01&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'));}"
          }
        ]
