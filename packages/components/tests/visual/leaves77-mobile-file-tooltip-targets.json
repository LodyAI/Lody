{
  "viewports": [
    {
      "name": "phone",
      "device": "iPhone SE",
      "width": 390,
      "height": 900
    }
  ],
  "themes": ["light", "dark"],
  "reducedMotion": "reduce",
  "ids": ["sessions-codecollabhtmlpreview--mobile-preview"],
  "ready": {
    "sessions-codecollabhtmlpreview--mobile-preview": [
      {
        "action": "visible",
        "role": "button",
        "name": "Hide preview"
      },
      {
        "action": "hover",
        "role": "button",
        "name": "Hide preview"
      },
      {
        "action": "waitForFunction",
        "expression": "()=>{const root=document.documentElement,wanted=new URL(location.href).searchParams.get('globals')?.match(/theme:(light|dark)/)?.[1],b=document.querySelector(\"button[aria-label=\\\"Hide preview\\\"]\"),p=document.querySelector(\"div[data-base-ui-focusable][data-side]:not([role])\");if(!b||!p||root.classList.contains('dark')!==(wanted==='dark')||b.getAttribute('aria-pressed')!==\"true\")return false;const c=getComputedStyle(p),r=p.getBoundingClientRect();return p.textContent===\"Hide preview\"&&c.fontSize==='12px'&&c.lineHeight==='16px'&&c.opacity==='1'&&!p.hasAttribute('data-starting-style')&&!p.hasAttribute('data-ending-style')&&r.width>0&&r.height>0&&r.left>=-.01&&r.right<=innerWidth+.01&&r.top>=-.01&&r.bottom<=innerHeight+.01&&document.fonts.status==='loaded'&&document.getAnimations().every(a=>a.effect?.getTiming().iterations===Infinity||(!a.pending&&a.playState!=='running'));}"
      }
    ]
  },
