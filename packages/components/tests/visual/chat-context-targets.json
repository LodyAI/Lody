{
  "viewports": [
    {
      "name": "desktop",
      "width": 1280,
      "height": 900
    },
    {
      "name": "tablet",
      "width": 768,
      "height": 900
    },
    {
      "name": "phone-compact",
      "width": 390,
      "height": 844
    }
  ],
  "themes": [
    "light",
    "dark"
  ],
  "blockedHosts": [
    "avatars.githubusercontent.com"
  ],
  "ids": [
    "chat-migration--context-disabled-action",
    "chat-migration--context-disabled-tooltip"
  ],
  "states": {
    "chat-migration--context-disabled-action": [
      {
        "name": "local-hover",
        "steps": [
          {
            "action": "hover",
            "role": "button",
            "name": "Local Add folder"
          }
        ]
      },
      {
        "name": "local-action",
        "steps": [
          {
            "action": "click",
            "role": "button",
            "name": "Local Add folder"
          },
          {
            "action": "visible",
            "selector": "output[aria-label=\"Last action\"]:has-text(\"Add folder\")"
          }
        ]
      },
      {
        "name": "github-hover",
        "steps": [
          {
            "action": "hover",
            "role": "button",
            "name": "GitHub Connect GitHub"
          }
        ]
      },
      {
        "name": "github-action",
        "steps": [
          {
            "action": "click",
            "role": "button",
            "name": "GitHub Connect GitHub"
          }
        ]
      }
    ],
    "chat-migration--context-disabled-tooltip": [
      {
        "name": "tooltip-open",
        "steps": [
          {
            "action": "hover",
            "role": "button",
            "name": "Local"
          },
          {
            "action": "visible",
            "text": "Desktop only"
          }
        ]
      },
      {
        "name": "tooltip-close",
        "steps": [
          {
            "action": "click",
            "role": "button",
            "name": "Outside control"
          },
          {
            "action": "hidden",
            "text": "Desktop only"
          }
        ]
      }
    ]
  }
}
