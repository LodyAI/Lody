  "devDependencies": {
    "@loro-dev/flock-wasm": "catalog:",
    "@types/node": "catalog:",
    "loro-crdt": "catalog:",
    "tsx": "4.23.13",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  }
}
