    "bench:ledger-10k-browser": "tsx bench/ledger-10k-browser.ts",
    "bench:ledger-extend": "tsx bench/ledger-extend.ts",
    "bench:c3-browser": "tsx bench/c3-browser.ts",
    "bench:l7-production-cas": "tsx bench/l7-production-cas.ts",
    "bench:l7-sqlite-riverrun-race": "tsx bench/l7-sqlite-riverrun-race.ts",
    "bench:device-gap": "tsx bench/device-gap.ts",
    "bench:ed25519-backends": "tsx bench/ed25519-backends.ts",
    "format": "prettier --write src test bench package.json tsconfig.json README.md AGENTS.md",
    "format:check": "prettier --check src test bench package.json tsconfig.json README.md AGENTS.md"
  },
  "dependencies": {
    "@hpke/chacha20poly1305": "1.8.0",
    "@hpke/core": "1.9.0",
