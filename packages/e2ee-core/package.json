{
  "name": "@lody/e2ee-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect.ts",
    "./effect/platform": "./src/platform/index.ts",
    "./ledger": "./src/ledger/index.ts",
    "./ledger-node": "./src/ledger/node-store.ts",
    "./node-store": "./src/node-store.ts",
    "./node-epoch-store": "./src/node-epoch-store.ts",
    "./node-history-store": "./src/node-history-store.ts",
    "./node-device-store": "./src/node-device-store.ts",
    "./node-user-store": "./src/node-user-store.ts",
    "./node-received-key-store": "./src/node-received-key-store.ts",
    "./node-key-outbox": "./src/node-key-outbox.ts",
    "./streams": "./src/streams.ts",
    "./streams-content": "./src/streams-content.ts",
