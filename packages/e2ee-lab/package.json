{
  "name": "@lody/e2ee-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "scenario:collab": "vitest run test/collab-baseline.test.ts test/collab-scenario.test.ts",
    "attack:model": "vitest run test/restricted-agent.test.ts -t 'intervene mid-collaboration'",
    "replay": "vitest run test/replay-bytes.test.ts test/replay-cas.test.ts test/collab-scenario.test.ts -t 'fresh director'",
    "replay:pack": "tsx src/repro-cli.ts replay",
    "format": "prettier --write src test vendor/README.md package.json tsconfig.json README.md README.zh.md AGENTS.md vitest.config.ts",
    "format:check": "prettier --check src test vendor/README.md package.json tsconfig.json README.md README.zh.md AGENTS.md vitest.config.ts"
  },
  "dependencies": {
    "@lody/e2ee-core": "workspace:*",
    "@loro-dev/flock-wasm": "catalog:",
    "@loro-dev/sqlite-riverrun": "0.3.0",
    "@loro-dev/streams-client": "catalog:",
    "@loro-dev/streams-crdt": "file:./vendor/streams-crdt.tgz",
    "effect": "catalog:",
    "loro-crdt": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "4.23.13",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  }
}
